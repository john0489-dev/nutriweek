# Chave da API da Anthropic (obtenha em https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo usado para gerar os cardápios
ANTHROPIC_MODEL=claude-sonnet-4-5

# Porta do servidor
PORT=3333

# Segredo usado para assinar os tokens de login (JWT). Troque por um valor
# aleatório e secreto antes de ir pra produção — se não definir, o servidor
# gera um valor aleatório a cada start (e derruba todas as sessões).
JWT_SECRET=troque-por-um-valor-aleatorio-longo
