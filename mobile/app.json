{
  "expo": {
    "name": "NutriWeek",
    "slug": "nutriweek",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F5132"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutriweek.app"
    },
    "android": {
      "package": "com.nutriweek.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F5132"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
